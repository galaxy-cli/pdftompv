#!/bin/bash
#      _ __ | |/ _| |_ ___  _ __ ___  _ ____   __
# | '_ \ / _` | |_| __/ _ \| '_ ` _ \| '_ \ \ / /
# | |_) | (_| |  _| || (_) | | | | | | |_) \ V /
# | .__/ \__,_|_|  \__\___/|_| |_| |_| .__/ \_/
# |_|                                |_|
#
# pdftompv - PDF to MP3 converter using pdftotext, edge-tts (Neural AI), and MPV
#
# Project: https://github.com/galaxy-cli/pdftompv

VERSION="1.9.9"
PROGNAME=$(basename "$0")
SELECTED_VOICE="en-US-AriaNeural"
declare -a WORK_DIRS=()

cleanup() {
    [ -n "$EVINCE_PID" ] && kill "$EVINCE_PID" 2>/dev/null
    for dir in "${WORK_DIRS[@]}"; do [ -d "$dir" ] && rm -rf "$dir"; done
}
trap cleanup EXIT INT TERM

error_msg() { echo "${PROGNAME}: ${2:+$2: }$1" >&2; }

check_dep() {
    local cmd="$1" pkg="$2"
    if ! command -v "$cmd" >/dev/null 2>&1; then
        echo "${PROGNAME}: dependency '${cmd}' (${pkg}) is missing." >&2
        read -p "Install via apt? [y/N] " ans < /dev/tty
        [[ "$ans" =~ ^[Yy] ]] && sudo apt-get install -y "$pkg" || exit 1
    fi
}

# Installs edge-tts (via pipx) the first time it's actually needed, rather
# than unconditionally at startup -- only --pdf and a standalone --voice
# preview actually use it.
ensure_tts() {
    check_dep "pipx" "pipx"
    if ! command -v edge-tts >/dev/null 2>&1; then
        echo "${PROGNAME}: installing edge-tts via pipx..." >&2
        if ! { pipx ensurepath --quiet && pipx install edge-tts; }; then
            error_msg "Failed to install edge-tts via pipx."
            exit 1
        fi
        export PATH="$PATH:$HOME/.local/bin"
        if ! command -v edge-tts >/dev/null 2>&1; then
            error_msg "edge-tts installed but still not found on PATH. Try restarting your shell."
            exit 1
        fi
    fi
}

get_clipboard() {
    for cmd in xclip xsel wl-paste pbpaste; do
        if command -v "$cmd" >/dev/null 2>&1; then
            local content
            case "$cmd" in
                xclip) content=$(xclip -selection clipboard -o 2>/dev/null) ;;
                xsel)  content=$(xsel --clipboard --output 2>/dev/null) ;;
                *)     content=$("$cmd" 2>/dev/null) ;;
            esac
            content=$(printf '%s' "$content" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
            if [ -n "$content" ]; then
                printf '%s\n' "$content"
                return 0
            fi
            error_msg "Clipboard is empty."
            return 1
        fi
    done
    error_msg "No clipboard utility found."
    return 1
}

print_usage() {
    cat <<EOF
Usage: ${PROGNAME} [OPTION]... [URL | TARGET]
Options:
  --pdf              Convert PDF to MP3
  --open             Launch file based on extension (.pdf, .mp3, or .*)
  --voice            Set neural voice
  --url [LINK]       Download PDF (reads clipboard if LINK is omitted)
  --version          List script version
  --help             List help menu

Report bugs to: <https://github.com/galaxy-cli/pdftompv/issues>
EOF
}

convert_pdf_to_mp3() {
    check_dep "pdftotext" "poppler-utils"
    ensure_tts

    local pdf="$1" mp3_final="${1%.*}.mp3" start_time=$SECONDS
    local work_dir=$(mktemp -d -t pdftompv-XXXXXXXX) && WORK_DIRS+=("$work_dir")
    local txt_file="$work_dir/extracted.txt"

    echo "${PROGNAME}: extracting text..." >&2
    pdftotext -raw "$pdf" "$txt_file" 2>/dev/null
    if [ ! -s "$txt_file" ]; then error_msg "Extraction failed or file empty" "$pdf"; exit 1; fi

    # Join into one line (removes the PDF's hard line-wraps) and collapse
    # dot-leaders/ellipses, then re-wrap at a fixed width so there are real
    # line boundaries again. 'split -l' below divides by LINE count, so
    # without this re-wrap step the whole document stays as a single line
    # and "splitting" always produces exactly one chunk no matter how long
    # the document is -- silently defeating the parallel rendering and
    # per-chunk retry logic below.
    sed ':a;N;$!ba;s/\n/ /g' "$txt_file" | sed 's/\.\.\././g' | fold -w 4000 -s > "$work_dir/clean.txt"
    split -d -a 4 -l 1 "$work_dir/clean.txt" "$work_dir/chunk_"

    shopt -s nullglob
    local chunks=("$work_dir"/chunk_[0-9]*)
    shopt -u nullglob
    local total=${#chunks[@]}

    if [ "$total" -eq 0 ]; then
        error_msg "No text content extracted from PDF after cleaning." "$pdf"
        exit 1
    fi

    echo "${PROGNAME}: rendering audiobook segments via [${SELECTED_VOICE}] in parallel..." >&2

    # Scale parallel jobs up to CPU core count (throttled to limit API rate spikes)
    local max_jobs=$(nproc 2>/dev/null || echo 4)

    for chunk in "${chunks[@]}"; do
        (
            for attempt in {1..3}; do
                if edge-tts --file "$chunk" --write-media "${chunk}.mp3" --rate=+25% --voice "$SELECTED_VOICE" >/dev/null 2>&1; then
                    exit 0
                fi
                sleep 2
            done
            error_msg "Chunk processing failure after 3 attempts" "$chunk"
            exit 1
        ) &

        # Keep job counts within thread pool bounds
        while [ $(jobs -r | wc -l) -ge "$max_jobs" ]; do
            sleep 0.2
        done
    done

    # --- LIVE PROCESSING TIMER LOOP ---
    local elapsed=0
    while true; do
        local running_jobs=$(jobs -r | wc -l)
        [ "$running_jobs" -eq 0 ] && break

        local completed_files=$(find "$work_dir" -name "chunk_*.mp3" -type f | wc -l)
        echo -ne "${PROGNAME}: Processing... [Time elapsed: ${elapsed}s] [Chunks complete: ${completed_files}/${total}]\r" >&2

        sleep 1
        ((elapsed++))
    done
    echo "" >&2

    # Verify all compiled chunks successfully generated matching media pieces
    for chunk in "${chunks[@]}"; do
        if [ ! -s "${chunk}.mp3" ]; then
            error_msg "Audio synthesis step incomplete due to job execution tracking faults."
            exit 1
        fi
    done

    echo "${PROGNAME}: stitching processed binary audio tracks..." >&2
    cat "$work_dir"/chunk_[0-9]*.mp3 > "$mp3_final"
    echo "${PROGNAME}: complete -> ${mp3_final}" >&2
}

# --- PARSE COMMAND LINE ARGUMENTS ---
[ $# -eq 0 ] && print_usage && exit 2
do_pdf=false; do_open=false; use_url=false; voice_test=false; input=""

while [ $# -gt 0 ]; do
    case "$1" in
        --pdf)  do_pdf=true; shift ;;
        --open) do_open=true; shift ;;
        --version) echo "${PROGNAME} ${VERSION}"; exit 0 ;;
        --help)    print_usage; exit 0 ;;
        --voice)
            if [ -z "$2" ]; then
                gallery_url="https://json2video.com/ai-voices/azure/voices/"
                if command -v xdg-open >/dev/null 2>&1; then
                    echo "Opening Azure voice gallery in your browser..." >&2
                    xdg-open "$gallery_url" >/dev/null 2>&1 &
                else
                    echo "Azure voice gallery: $gallery_url" >&2
                fi
                exit 0
            fi
            SELECTED_VOICE="$2"; voice_test=true; shift 2 ;;
        --url)
            use_url=true
            if [ -n "$2" ] && [[ "$2" != -* ]]; then input="$2"; shift 2; else input=$(get_clipboard) || exit 1; shift 1; fi ;;
        -*)     error_msg "Unrecognized option '$1'"; exit 2 ;;
        *)      input="$1"; shift ;;
    esac
done

# Short-circuit for solo voice testing
if [ "$voice_test" = true ] && [ -z "$input" ] && [ "$do_pdf" = false ] && [ "$do_open" = false ]; then
    check_dep "mpv" "mpv"
    ensure_tts
    work_dir=$(mktemp -d -t pdftompv-XXXXXXXX) && WORK_DIRS+=("$work_dir")
    edge-tts --text "Hello! Previewing voice profile." --write-media "$work_dir/t.mp3" --rate=+25% --voice "$SELECTED_VOICE" >/dev/null 2>&1
    mpv "$work_dir/t.mp3"; exit 0
fi

[ -z "$input" ] && { error_msg "Missing target file or URL"; exit 2; }
[[ "$input" =~ ^https?:// ]] && use_url=true

# Handle URL Downloading
if [ "$use_url" = true ]; then
    check_dep "wget" "wget"
    clean_url="${input%%\?*}"
    filename=$(basename "$clean_url")
    filename=$(python3 -c "import urllib.parse; print(urllib.parse.unquote('''$filename'''))")
    [[ "$filename" != *.pdf ]] && filename="${filename%.*}.pdf"
    [ -z "$filename" ] && filename="downloaded_document.pdf"
    wget -q --show-progress -O "$filename" "$input" || exit 1
    input="$filename"
fi

# Standardize File Extensions & Track Suffix Intent
base="${input%.*}"
if [ "$use_url" = true ] || { [[ "$input" == *.* ]] && [[ "$input" != *.pdf && "$input" != *.mp3 ]]; }; then
    mode="wildcard"
elif [[ "$input" == *.pdf ]]; then
    mode="pdf"
elif [[ "$input" == *.mp3 ]]; then
    mode="mp3"
elif [[ "$input" != *.* ]]; then
    # No extension at all -- treat as an implicit PDF target. This used to
    # fall through to the generic error below even though that message
    # explicitly says ".* " (any extension) is acceptable.
    mode="pdf"
else
    error_msg "Target must end in .pdf, .mp3, or .*"; exit 2
fi

# Execute Operational Chain
[ "$do_pdf" = true ] && convert_pdf_to_mp3 "${base}.pdf"

if [ "$do_open" = true ]; then
    case "$mode" in
        pdf)      check_dep "evince" "evince"
                  [ -f "${base}.pdf" ] && evince "${base}.pdf" >/dev/null 2>&1 || { error_msg "PDF missing" "${base}.pdf"; exit 1; } ;;
        mp3)      check_dep "mpv" "mpv"
                  [ -f "${base}.mp3" ] && mpv "${base}.mp3" || { error_msg "MP3 missing" "${base}.mp3"; exit 1; } ;;
        wildcard) check_dep "evince" "evince"
                  check_dep "mpv" "mpv"
                  if [ -f "${base}.pdf" ]; then
                      # Backgrounded directly in this shell (not inside a
                      # subshell) so EVINCE_PID is actually visible to the
                      # cleanup() trap -- a subshell assignment here would
                      # be discarded the instant the subshell exits,
                      # silently leaving evince un-killable on exit.
                      evince "${base}.pdf" >/dev/null 2>&1 &
                      EVINCE_PID=$!
                  fi
                  [ -f "${base}.mp3" ] && mpv "${base}.mp3" || { error_msg "MP3 missing" "${base}.mp3"; exit 1; } ;;
    esac
fi
